    {
      "id": "data-report",
      "title": "Data Report",
      "format": "html",
      "source": "Examples/sources/data-report.md",
      "script": "Examples/render-data-report.sh",
      "output": "Examples/outputs/data-report.html",
      "features": ["metrics", "tables", "equations", "operational review"]
    },
    {
      "id": "onboarding-guide",
      "title": "Onboarding Guide",
      "format": "html",
      "source": "Examples/sources/onboarding-guide.md",
      "script": "Examples/render-onboarding-guide.sh",
      "output": "Examples/outputs/onboarding-guide.html",
      "features": ["tutorial writing", "steps", "callouts", "CLI snippets"]
    },
    {
      "id": "component-playbook",
      "title": "Component Playbook",
      "format": "html",
      "source": "Examples/sources/component-playbook.md",
      "script": "Examples/render-component-playbook.sh",
      "output": "Examples/outputs/component-playbook.html",
